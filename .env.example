# Copy to .env and fill in. Never commit the filled-in file.
#
#   cp .env.example .env            # docker-compose reads this one
#   cp .env.example backend/.env    # Django reads this one
#
# Values are intentionally empty — there are no working defaults to inherit.

# --- Django ---------------------------------------------------------------
SECRET_KEY=
DEBUG=

# --- Database -------------------------------------------------------------
# DATABASE_URL is what Django actually reads. The POSTGRES_* vars configure the
# postgres container in docker-compose.yml and must agree with it.
# Example: postgres://vero:vero@localhost:5432/vero
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Cache / broker -------------------------------------------------------
# Example: redis://localhost:6379/0
REDIS_URL=

# --- Authentication (Supabase) --------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- AI ---------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
