# ---------------------------------------------------------------------------
# Patterns here are intentionally NOT anchored with a leading slash. In a
# monorepo the same artifacts appear at several depths (apps/web/.next,
# backend/.venv, ...), and root-anchored patterns would silently stop matching
# once the app moved out of the repository root.
# ---------------------------------------------------------------------------

# dependencies
node_modules/
.pnp
.pnp.*

# next.js
.next/
out/
build/

# typescript
*.tsbuildinfo
next-env.d.ts

# python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# django
*.sqlite3
/backend/staticfiles/
/backend/mediafiles/

# env files
.env
.env.local
.env.*.local

# editors / os
.DS_Store
.idea/
*.swp
*.pem

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
celerybeat-schedule
